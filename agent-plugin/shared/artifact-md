def _env(*names: str) -> str | None:
    for name in names:
        val = os.environ.get(name)
        if val:
            return val
    return None


def _target(raw: str) -> tuple[str, str]:
    parsed = urllib.parse.urlsplit(raw.strip().rstrip("/"))
    if parsed.scheme not in ("http", "https") or not parsed.hostname:
        raise ValueError(f"Invalid Artifact Site URL: {raw}")
    host = parsed.hostname.lower()
    if ":" in host and not host.startswith("["):
        host = f"[{host}]"
    port = parsed.port
    if port is not None and port != (443 if parsed.scheme == "https" else 80):
        host = f"{host}:{port}"
    base = urllib.parse.urlunsplit((parsed.scheme, host, parsed.path.rstrip("/"), "", ""))
    return base, re.sub(r"[^a-z0-9.\-]", "_", host)


def load_connection() -> tuple[str, str | None]:
    custom = _env("ARTIFACT_SITE_CONFIG_DIR", "ARTIFACT_HUB_CONFIG_DIR")
    xdg = pathlib.Path(_env("XDG_CONFIG_HOME") or (pathlib.Path.home() / ".config"))
    dirs = [pathlib.Path(custom)] if custom else [xdg / "artifact-site", xdg / "artifact-hub"]

    stored: dict = {}
    for d in dirs:
        cfg = d / "config.json"
        if cfg.is_file():
            try:
                data = json.loads(cfg.read_text(encoding="utf-8"))
                if isinstance(data, dict):
                    stored = data
                    break
            except Exception:
                pass

    env_base = _env("ARTIFACT_SITE_URL", "ARTIFACT_HUB_URL")
    raw_base = env_base or stored.get("baseUrl") or "https://yours.lexmount.com/artifact-site"
    base, host_key = _target(raw_base)

    token = _env("ARTIFACT_SITE_TOKEN", "ARTIFACT_HUB_TOKEN")
    if token and env_base and _target(env_base)[0] != base:
        token = None
    if not token:
        for d in dirs:
            tf = d / "tokens" / host_key
            if tf.is_file():
                token = tf.read_text(encoding="utf-8").strip() or None
                if token:
                    break
    return base, token


def find_node_and_cli() -> tuple[str, str] | None:
    if os.environ.get("ARTIFACT_MD_FORCE_HTTP") == "1":
        return None
    node_candidates: list[str] = []
    which_node = shutil.which("node")
    if which_node:
        node_candidates.append(which_node)
    node_candidates.extend([
        "/opt/homebrew/opt/node@24/bin/node",
        "/opt/homebrew/bin/node",
        "/usr/local/opt/node@24/bin/node",
        "/usr/local/bin/node",
    ])
    node_candidates.extend(sorted(glob.glob(os.path.expanduser("~/.nvm/versions/node/v2[4-9]*/bin/node")), reverse=True))
    node_candidates.extend([
        os.path.expanduser("~/.volta/bin/node"),
        os.path.expanduser("~/.local/bin/node"),
    ])

    node_bin: str | None = None
    seen: set[str] = set()
    for cand in node_candidates:
        if not cand or cand in seen or not os.path.isfile(cand) or not os.access(cand, os.X_OK):
            continue
        seen.add(cand)
        try:
            res = subprocess.run([cand, "-p", "process.versions.node.split('.')[0]"], capture_output=True, text=True, timeout=3)
            if res.returncode == 0 and int(res.stdout.strip()) >= 24:
                node_bin = cand
                break
        except Exception:
            continue
    if not node_bin:
        return None

    me = os.path.realpath(__file__)
    cli_candidates: list[str] = [
        "/opt/homebrew/lib/node_modules/@artifact-site/cli/bin/artifact-site.js",
        "/opt/homebrew/bin/artifact-site",
        "/usr/local/lib/node_modules/@artifact-site/cli/bin/artifact-site.js",
        "/usr/local/bin/artifact-site",
        os.path.expanduser("~/.npm-global/bin/artifact-site"),
    ]
    for p in os.environ.get("PATH", "").split(os.pathsep):
        cand = os.path.join(p, "artifact-site")
        if os.path.isfile(cand) and os.path.realpath(cand) != me:
            cli_candidates.append(cand)
    for cand in cli_candidates:
        if not os.path.isfile(cand) or os.path.realpath(cand) == me:
            continue
        is_node = cand.endswith((".js", ".mjs", ".cjs"))
        if not is_node:
            try:
                with open(cand, "rb") as f:
                    is_node = b"node" in f.readline(128)
            except Exception:
                is_node = False
        if is_node:
            return node_bin, cand
    return None


def extract_slug(slug_or_url: str) -> str:
    s = slug_or_url.strip().rstrip("/")
    m = re.search(r"/s/([A-Za-z0-9_-]+)", s)
    if m:
        return m.group(1)
    if "://" in s:
        return s.rsplit("/", 1)[-1]
    return s


def extract_title(md_text: str, fallback: str) -> str:
    for line in md_text.splitlines():
        m = re.match(r"^#\s+(.+?)\s*$", line)
        if m:
            return re.sub(r"[*_`#]", "", m.group(1)).strip()
    return fallback


def build_html(md_path: str, title: str | None) -> tuple[str, str]:
    md_text = sys.stdin.read() if md_path == "-" else pathlib.Path(md_path).read_text(encoding="utf-8")
    fallback = "Document" if md_path == "-" else pathlib.Path(md_path).stem
    resolved_title = title or extract_title(md_text, fallback)
    md_json = json.dumps(md_text, ensure_ascii=False).replace("</", "<\\/")
    rendered = (
        HTML_TEMPLATE
        .replace("__TITLE_ESC__", html.escape(resolved_title))
        .replace("__RAW_ESC__", html.escape(md_text))
        .replace("__MD_JSON__", md_json)
    )
    return rendered, resolved_title


def http_json(method: str, url: str, token: str | None, payload: dict | None = None, extra_headers: dict | None = None) -> dict:
    headers = {"Accept": "application/json", "User-Agent": "artifact-md/1.0"}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    if extra_headers:
        headers.update(extra_headers)
    data = None
    if payload is not None:
        headers["Content-Type"] = "application/json"
        data = json.dumps(payload, ensure_ascii=False).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            return json.loads(raw) if raw.strip() else {}
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        sys.stderr.write(f"HTTP {exc.code} from {url}: {body}\n")
        sys.exit(1)


def main() -> None:
    p = argparse.ArgumentParser(description="Render Markdown (GFM + Mermaid + KaTeX + code highlight) and publish/update on Yours (artifact-site).")
    sub = p.add_subparsers(dest="cmd", required=True)

    p_pub = sub.add_parser("publish", help="Render Markdown and publish as a single-page HTML artifact")
    p_pub.add_argument("file", help="Markdown file path, or - for stdin")
    p_pub.add_argument("-t", "--title", help="Artifact title (defaults to first # heading)")
    p_pub.add_argument("--json", action="store_true", help="Machine-readable JSON output")
    p_pub.add_argument("--official", action="store_true", help="Mark as official version")
    p_pub.add_argument("--operation-key", help="Idempotency operation key")

    p_upd = sub.add_parser("update", help="Render Markdown and update an existing artifact in-place (same URL)")
    p_upd.add_argument("slug", help="Existing artifact slug or full /s/<slug> URL")
    p_upd.add_argument("file", help="Updated Markdown file path, or - for stdin")
    p_upd.add_argument("-t", "--title", help="Optional new title")
    p_upd.add_argument("--expected-version", help="Expected version ID (auto-fetched from info if omitted)")
    p_upd.add_argument("--json", action="store_true", help="Machine-readable JSON output")

    p_ren = sub.add_parser("render", help="Render Markdown to local standalone HTML without uploading")
    p_ren.add_argument("file", help="Markdown file path, or - for stdin")
    p_ren.add_argument("-o", "--out", help="Output HTML file path (stdout if omitted)")
    p_ren.add_argument("-t", "--title", help="Page title")

    args = p.parse_args()

    if args.cmd == "render":
        html_doc, _ = build_html(args.file, args.title)
        if args.out:
            pathlib.Path(args.out).write_text(html_doc, encoding="utf-8")
        else:
            sys.stdout.write(html_doc)
        return

    cli_pair = find_node_and_cli()

    if args.cmd == "publish":
        html_doc, resolved_title = build_html(args.file, args.title)
        if cli_pair:
            node_bin, as_bin = cli_pair
            cli_args = [node_bin, as_bin, "publish", "-", "--title", resolved_title]
            if args.official:
                cli_args.append("--official")
            if args.operation_key:
                cli_args.extend(["--operation-key", args.operation_key])
            if args.json:
                cli_args.append("--json")
            res = subprocess.run(cli_args, input=html_doc, text=True)
            sys.exit(res.returncode)

        base, token = load_connection()
        if not token:
            sys.stderr.write("artifact-md: missing token in ~/.config/artifact-site (or ARTIFACT_SITE_TOKEN)\n")
            sys.exit(1)
        extra_h = {"Idempotency-Key": args.operation_key} if args.operation_key else None
        out = http_json("POST", f"{base}/api/sites", token, {"mode": "paste", "html": html_doc, "title": resolved_title, "official": bool(args.official)}, extra_h)
        slug = out.get("slug") or (out.get("site") or {}).get("slug")
        site_url = f"{base}/s/{slug}" if slug else out.get("url", "")
        if args.json:
            out.setdefault("siteUrl", site_url)
            print(json.dumps(out, ensure_ascii=False))
        else:
            print(site_url)
        return

    if args.cmd == "update":
        slug = extract_slug(args.slug)
        html_doc, _ = build_html(args.file, args.title)
        if cli_pair:
            node_bin, as_bin = cli_pair
            ver_id = args.expected_version
            remote_file = "index.html"
            if not ver_id:
                info_res = subprocess.run([node_bin, as_bin, "info", slug, "--json"], capture_output=True, text=True)
                if info_res.returncode != 0:
                    sys.stderr.write(info_res.stderr or info_res.stdout)
                    sys.exit(info_res.returncode)
                info = json.loads(info_res.stdout)
                ver_id = (
                    info.get("currentVersionId")
                    or info.get("versionId")
                    or (info.get("currentVersion") or {}).get("id")
                    or (info.get("site") or {}).get("currentVersionId")
                )
                remote_file = (
                    info.get("file")
                    or (info.get("version") or {}).get("entry")
                    or (info.get("files") or ["index.html"])[0]
                )
                if not ver_id:
                    sys.stderr.write(f"Could not determine current versionId from info: {info_res.stdout}\n")
                    sys.exit(1)

            cli_args = [node_bin, as_bin, "edit", slug, "-", "--file", remote_file, "--expected-version", ver_id]
            if args.json:
                cli_args.append("--json")
            res = subprocess.run(cli_args, input=html_doc, text=True)
            if res.returncode != 0:
                sys.exit(res.returncode)
            if args.title:
                t_res = subprocess.run([node_bin, as_bin, "update", slug, "--title", args.title] + (["--json"] if args.json else []))
                sys.exit(t_res.returncode)
            return

        base, token = load_connection()
        if not token:
            sys.stderr.write("artifact-md: missing token in ~/.config/artifact-site (or ARTIFACT_SITE_TOKEN)\n")
            sys.exit(1)
        ver_id = args.expected_version
        if not ver_id:
            info = http_json("GET", f"{base}/api/sites/{urllib.parse.quote(slug)}", token)
            ver_id = (
                info.get("currentVersionId")
                or info.get("versionId")
                or (info.get("site") or {}).get("currentVersionId")
            )
            if not ver_id:
                sys.stderr.write(f"Could not determine currentVersionId for {slug}\n")
                sys.exit(1)
        q = f"?expected_version={urllib.parse.quote(ver_id)}"
        out = http_json("POST", f"{base}/api/sites/{urllib.parse.quote(slug)}/edit{q}", token, {"content": html_doc})
        if args.title:
            http_json("PATCH", f"{base}/api/sites/{urllib.parse.quote(slug)}", token, {"title": args.title})
        if args.json:
            print(json.dumps(out, ensure_ascii=False))
        else:
            print(f"{base}/s/{slug}")


