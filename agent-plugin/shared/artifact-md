#!/usr/bin/env python3
"""Render Markdown (GFM + Mermaid + KaTeX + code highlight) to standalone HTML
and publish or update it in-place on Yours (artifact-site).

Uses @artifact-site/cli when Node 24+ and the CLI are installed; otherwise falls
back directly to the Yours HTTP API with ~/.config/artifact-site credentials, so
remote Linux/HPC machines with only Python 3.9+ work identically.
"""
from __future__ import annotations

import argparse
import glob
import html
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request

