#!/usr/bin/env python3
"""Claude Code hook for Herdr's ⌃Tab agent switcher (~/.config/herdr-app/mods/agent-switcher).

UserPromptSubmit: the start of the prompt goes in the hc label note.prompt.
Stop: the end of the reply (its last two lines) goes in note.said.
Each also sets note.state: "working" from a prompt until the reply ends, then "idle". Herdr's
Agents list, tab bar and Projects panel read it for sessions that report no status to Herdr
(background ones, `claude attach`) when the tab bar's own label from Claude's record of the
session (note.job, mods/my-tabs/jobs.js) isn't there. An interrupted reply has no Stop: it stays
"working" until the next prompt or reply.
SessionStart: a resumed conversation's card (or a fork's, a copy of one) shows its last prompt
and reply right away, read from its transcript, not only after the next prompt. A new one (or
/clear) drops the notes the terminal kept from the conversation before.
PermissionRequest: what Claude waits for you on (a tool to allow, its AskUserQuestion questions)
goes in note.ask, for the phone app (herdr-mobile), which shows it as a card you can answer.
Claude writes that call to its transcript only once it has run, at times (Claude Code 2.1.329:
a two-question ask reached the file after it was answered), so the transcript can't tell. A
prompt, a reply's end or a new session takes it down; a client keeps it only while the session
says it is blocked, and only if it is newer than the last time it stopped waiting.
Each also says where the conversation is, for Herdr's Fork button (mods/my-pane/fork.js), which
starts a copy of it: note.session (its id), note.cwd (its folder) and note.host, the host Claude
runs on when that isn't the terminal's own (a compute node, see below; dropped otherwise). Fork
reaches that host with ssh from the terminal's machine.
All land on the hc terminal the agent runs in ($HC_TERMINAL_ID). A background session runs
under Claude's daemon ($CLAUDE_JOB_DIR), outside any terminal; the $HC_TERMINAL_ID it has is the
daemon's, from whichever terminal started the daemon. Its labels go on every terminal showing
it, found through hc: each running `claude attach <its id>`, else a `claude` window (`claude
--resume` on a background job) titled with the job's name. Outside hc it does nothing. It
prints nothing (a UserPromptSubmit or SessionStart hook's output would join the conversation)
and always exits 0, so it never gets in Claude's way.

note.bg: a background session on a machine without Herdr's app (a server) also says its state
there, for the tab bar on the Mac, which watches only the Mac's own records of Claude's
background sessions (mods/my-tabs/jobs.js). "<state> <job> <time>": working from a prompt; at
the end of a turn, how Claude recorded it ended (done, blocked, or still working when it waits
on its own task), read from ~/.claude/jobs/<job>/state.json once Claude has written it.

A compaction between turns (PreCompact; SessionStart after it, in case that came too late):
Claude reports it to the terminal like a turn, working and then done, and Herdr alerts you
for that done as for a finished turn. That is Claude's own compaction while idle (a long
conversation, about an hour after its last reply, before the prompt cache expires) and
/compact. So once Claude says working, the status is cleared (OSC 7501 state=clear, written
to Claude's terminal): Herdr takes a done that doesn't follow working as one you've seen, so
there's no sound, toast or done mark. Only when you've seen the last finish (herdr.seen at the
terminal's turn count). One you haven't seen keeps its mark and alerts again. A compaction
in the middle of a turn (the context filled up) reports nothing of its own and is left
alone. A prompt sent during the compaction runs right after it, and Claude doesn't say
working again, so the next UserPromptSubmit says it for Claude if the status is still cleared.
Only a compaction that made Claude say working is hushed. If Claude was working already (its
status in hc older than the compaction), it keeps working through the compaction and says
nothing when it ends: no done to hush, and a cleared status would stay cleared until Claude's
next change. Herdr's panels would then lose a Claude that runs over ssh (the terminal's own
program is ssh or a script), and miss its real finish later. That's a subagent's compaction
(PreCompact gives the main transcript; agent_id only from Claude Code 2.1.326) or any compaction
while background agents run after the turn.

On a cluster compute node the terminal's hc runs on the login node. There the label goes
through `ssh <login node>`: $HC_VIA, or Slurm's $SLURM_SUBMIT_HOST in an idev session.
(Vista: plain ssh from a node to login1 needs no MFA; BatchMode=yes would break it.)

Codex runs it too, as `agent-note codex` (~/.codex/hooks.json, see codex() below), for the same
notes plus note.ask, what it waits for your approval on.

The Antigravity CLI (agy) runs it twice over: as `agent-note antigravity`, its hook
(~/.gemini/config/hooks.json, see antigravity() below), for the same notes; and as `agent-note
agy-title`, its title command (~/.gemini/antigravity-cli/settings.json "title", see agy_title()),
which names its terminal after the conversation, as Claude names its own after the session.
"""
import base64
import glob
import json
import os
import re
import shlex
import shutil
import socket
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone


def main():
    mode = sys.argv[1:2]
    if mode == ["antigravity"]:
        print("{}", flush=True)  # agy reads a JSON object from every hook; this one asks nothing
    event = json.load(sys.stdin)
    if mode == ["codex"]:
        return codex(event)
    if mode == ["antigravity"]:
        return antigravity(event)
    if mode == ["agy-title"]:
        return agy_title(event)
    job, own = os.environ.get("CLAUDE_JOB_DIR"), os.environ.get("HC_TERMINAL_ID")
    name, start = event.get("hook_event_name"), time.time()
    if name == "PreCompact" or (name == "SessionStart" and event.get("source") == "compact"):
        path = event.get("transcript_path")
        if own and not job and not event.get("agent_id") and (event.get("trigger") == "manual" or between_turns(path, after=name == "SessionStart")):
            began = start if name == "PreCompact" else compaction_began(path, start)
            if began is not None:
                hush(own, wait=8.0 if name == "PreCompact" else 0, began=began)
        return
    if name == "UserPromptSubmit" and own and not job:
        try:
            unhush(own)
        except Exception:
            pass  # the labels below still go on
    terms = [own] if own and not job else attached(event.get("session_id"))
    if not terms:
        return
    if name == "PermissionRequest":
        for term in terms:
            label(term, f"note.ask={asked(event)}")
        return
    report = bool(job) and not os.path.isdir(os.path.expanduser("~/.config/herdr-app"))
    if name == "UserPromptSubmit":
        key, text, state = "note.prompt", " ".join((event.get("prompt") or "").split())[:160], "working"
    elif name == "Stop":
        reply = event.get("last_assistant_message") or last_reply(event.get("transcript_path"))
        key, text, state = "note.said", gist(reply), "idle"
    elif name == "SessionStart":
        source, path = event.get("source"), event.get("transcript_path")
        if source in ("resume", "fork"):
            prompt, reply = last_prompt(path), gist(last_reply(path))
            pairs = ("note.state=idle", f"note.prompt={prompt}" if prompt else "note.prompt=", f"note.said={reply}" if reply else "note.said=", "note.ask=")
        elif source in ("startup", "clear"):
            pairs = ("note.state=idle", "note.prompt=", "note.said=", "note.ask=")
        else:
            return
    else:
        return
    if name != "SessionStart":
        pairs = (f"note.state={state}", *([f"{key}={text}"] if text else []), "note.ask=")
        if report and name == "UserPromptSubmit":
            pairs += (f"note.bg=working {os.path.basename(job.rstrip('/'))} {now()}",)
    pairs += where(event)
    for term in terms:
        label(term, *pairs)
    if report and name == "Stop":
        value = bg_state(job)
        for term in terms:
            label(term, f"note.bg={value}")


def codex(event):
    """Codex runs this hook too, from ~/.codex/hooks.json as `agent-note codex`. Its hooks give the
    same input as Claude Code's, and the same notes go on its terminal: note.prompt, note.said,
    note.state, note.session (the thread's id), note.cwd and note.host. One more, note.ask: what a
    Codex waiting for your approval wants to do (PermissionRequest), for a client that answers it
    from elsewhere. It goes
    when the tool runs (PostToolUse), the turn ends (Stop) or is cut off (Interrupt, as when you
    say no), or a prompt comes.
    Only a Codex that runs its session itself: `codex --no-daemon`, or with -c/--enable options.
    By default Codex hands sessions to a shared background server, which runs their hooks with
    its own environment, the $HC_TERMINAL_ID of whichever terminal started it: nested() leaves
    those alone."""
    own, name = os.environ.get("HC_TERMINAL_ID"), event.get("hook_event_name")
    if not own or event.get("agent_id"):
        return  # outside hc; or a subagent's (Guardian review, …), which has its parent's session id
    sid = event.get("session_id") or ""
    if name == "PostToolUse":
        # The tool ran, so an approval it waited for was given. Only then an hc call: this runs
        # after every tool.
        if forget_ask(sid):
            label(own, "note.ask=")
        return
    if nested():
        return
    if name == "UserPromptSubmit":
        prompt = " ".join((event.get("prompt") or "").split())[:160]
        pairs = ("note.state=working", *([f"note.prompt={prompt}"] if prompt else []), "note.ask=")
    elif name == "Stop":
        reply = gist(event.get("last_assistant_message") or codex_last(event)[1])
        pairs = ("note.state=idle", *([f"note.said={reply}"] if reply else []), "note.ask=")
    elif name == "Interrupt":
        pairs = ("note.state=idle", "note.ask=")
    elif name == "PermissionRequest":
        os.makedirs(os.path.dirname(asking(sid)), exist_ok=True)
        open(asking(sid), "w").close()
        pairs = (f"note.ask={asked(event)}",)
    elif name == "SessionStart":
        source = event.get("source")
        if source in ("resume", "fork"):
            prompt, reply = codex_last(event)
            pairs = ("note.state=idle", f"note.prompt={prompt or ''}", f"note.said={gist(reply)}", "note.ask=")
        elif source in ("startup", "clear"):
            pairs = ("note.state=idle", "note.prompt=", "note.said=", "note.ask=")
        else:
            return  # compact: the same thread, the notes still hold
    else:
        return
    if name != "PermissionRequest":
        forget_ask(sid)
    label(own, *pairs, *where(event))


def asking(sid):
    """Marks a Codex session whose note.ask is up, so PostToolUse knows to take it down."""
    safe = re.sub(r"[^A-Za-z0-9-]", "", sid) or "none"
    return os.path.join(tempfile.gettempdir(), f"agent-note-{os.getuid()}", "ask-" + safe)


def forget_ask(sid):
    """Takes the mark down; whether there was one."""
    try:
        os.remove(asking(sid))
        return True
    except OSError:
        return False


def asked(event):
    """note.ask: {"t": when (UTC), "tool": the tool (Bash, apply_patch, mcp__server__tool,
    AskUserQuestion), "input": what it was given}, as one line of JSON, long values cut short.
    Claude's questions keep their options: past the length, the options' descriptions are cut
    short, then left out."""
    inp = event.get("tool_input")
    if isinstance(inp, dict):
        inp = {k: v[:3000] if isinstance(v, str) else v for k, v in list(inp.items())[:20]}
    else:
        inp = {"command": str(inp)[:3000]} if inp else {}
    note = {"t": now(), "tool": str(event.get("tool_name") or ""), "input": inp}
    s = json.dumps(note, ensure_ascii=False, separators=(",", ":"))
    for cut in (160, 0):
        if len(s) <= 8000 or not isinstance(inp.get("questions"), list):
            break
        qs = [dict(q, options=[dict(o, description=str(o.get("description") or "")[:cut]) if isinstance(o, dict) else o
                               for o in (q.get("options") or [])]) if isinstance(q, dict) else q for q in inp["questions"]]
        s = json.dumps({**note, "input": {**inp, "questions": qs}}, ensure_ascii=False, separators=(",", ":"))
    return s if len(s) <= 8000 else json.dumps({**note, "input": {}}, separators=(",", ":"))


def nested():
    """Whether this Codex isn't its terminal's own agent, so $HC_TERMINAL_ID isn't its terminal:
    one that Claude started (its Codex plugin, a command it ran), or a shared app server (Codex's
    background daemon, the desktop app), which has the environment of whatever started it.
    Read up the process tree."""
    pid = os.getppid()
    for _ in range(12):
        if pid <= 1:
            return False
        out = subprocess.run(["ps", "-o", "ppid=,args=", "-p", str(pid)], capture_output=True, text=True, timeout=3).stdout.strip()
        ppid, _, args = out.partition(" ")
        args = args.strip()
        if not args:
            return False
        if os.path.basename(args.split(" ", 1)[0]) == "claude" or "@anthropic-ai/claude-code" in args or " app-server" in " " + args:
            return True
        try:
            pid = int(ppid)
        except ValueError:
            return False
    return False


def codex_last(event):
    """The start of the last prompt in a Codex thread, and the reply to it (None while there's
    none), read from its records. A resumed thread goes on in a new file
    (~/.codex/sessions/…/rollout-<time>-<id>_<n>.jsonl), so the newest one that has a prompt."""
    sid = re.sub(r"[^A-Za-z0-9-]", "", event.get("session_id") or "")
    home = os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex")
    files = glob.glob(os.path.join(home, "sessions", "*", "*", "*", f"rollout-*-{sid}*.jsonl")) if sid else []
    path = event.get("transcript_path")
    if path and path not in files:
        files.append(path)

    def mtime(f):
        try:
            return os.path.getmtime(f)
        except OSError:
            return 0

    reply = None
    for f in sorted(files, key=mtime, reverse=True):
        for entry in tail_entries(f):
            p = entry.get("payload") if isinstance(entry, dict) and entry.get("type") == "event_msg" else None
            item = p.get("item") if isinstance(p, dict) and p.get("type") == "item_completed" else None
            if not isinstance(item, dict):
                continue
            text = "".join(c.get("text") or "" for c in item.get("content") or [] if isinstance(c, dict)).strip()
            if item.get("type") == "AgentMessage" and text and reply is None:
                reply = text
            elif item.get("type") == "UserMessage" and text:
                return " ".join(text.split())[:160], reply
    return None, None


AGY_HOME = os.path.expanduser("~/.gemini/antigravity-cli")  # the Antigravity CLI's records


def antigravity(event):
    """The Antigravity CLI (agy) runs this hook too, from ~/.gemini/config/hooks.json as `agent-note
    antigravity`, for the same notes on its terminal: note.prompt, note.said, note.state,
    note.session (the conversation's id), note.cwd and note.host. Its hooks get camelCase input, and
    agy waits for each one before it goes on, so this makes one hc call at a turn's start and one at
    its end, none in between. SessionStart comes once per conversation, with its first prompt (a
    conversation starts only then); PreInvocation before each call to the model, invocationNum 0 for
    a turn's first; Stop at the turn's end. A resumed conversation gets no hook at all: agy_title()
    notes it. main() has printed the {} agy wants back."""
    own, name, cid = os.environ.get("HC_TERMINAL_ID"), event.get("hookEventName"), event.get("conversationId") or ""
    if not own:
        return
    if name == "PreInvocation":
        if str(event.get("invocationNum") or 0) != "0":
            return  # the model again, within the turn
        prompt = " ".join((event.get("lastUserInput") or "").split())[:160]
        pairs = ("note.state=working", *([f"note.prompt={prompt}"] if prompt else []))
    elif name == "Stop":
        reply = gist(agy_last(agy_transcript(cid, event.get("transcriptPath")))[1])
        pairs = ("note.state=idle", f"note.said={reply}")
    elif name == "SessionStart":
        pairs = ("note.said=",)  # a new conversation: the reply shown was another's
    else:
        return
    if not agy_own():
        return
    label(own, *pairs, *where({"session_id": cid, "cwd": event.get("cwd")}))
    if cid:
        arrived(own, cid)  # where it is is known: the title command needn't say it again


def agy_title(state):
    """agy's title command (~/.gemini/antigravity-cli/settings.json "title"). agy runs it at each
    change of its state, with the session's state as JSON, and makes what it prints the terminal's
    title, where Herdr reads every agent's session name (the pane header, the Agents list, the tab
    bar, ⌃Tab, toasts). It prints the conversation's name: the one /rename gave it, else the title
    agy made for it itself (its /resume picker shows that; the state leaves it out), else nothing
    (a new conversation). agy clears the title when it exits.
    The first time it sees a conversation in its terminal (agy started, resumed, /clear), it also
    notes that conversation there, in the background: where it is, and while agy is idle, the
    conversation's last prompt and reply, or none (a resumed conversation gets no hook)."""
    cid = str(state.get("conversation_id") or "")
    name = state.get("conversation_title") or (agy_made_title(cid) if cid else "")
    print(" ".join(str(name or "").split()), flush=True)
    own = os.environ.get("HC_TERMINAL_ID")
    if own and cid and arrived(own, cid):
        up = os.getppid()  # agy, or its sh: the child's parent will be gone
        background(lambda: agy_arrived(own, cid, state, up))


def agy_arrived(own, cid, state, up):
    """A conversation new to its terminal, from the title command's state (agy_title); up: the
    process that ran the command."""
    if not agy_own(up):
        return
    pairs = ()
    if state.get("agent_state") == "idle":  # else a turn runs, and its hooks say it
        prompt, reply = agy_last(agy_transcript(cid, state.get("transcript_path")))
        pairs = ("note.state=idle", f"note.prompt={prompt or ''}", f"note.said={gist(reply)}")
    label(own, *pairs, *where({"session_id": cid, "cwd": state.get("cwd")}))


def arrived(term, cid):
    """Whether conversation cid is new to terminal term, since the last call for it: the title
    command runs often, and only a new one is noted."""
    path = os.path.join(tempfile.gettempdir(), f"agent-note-{os.getuid()}", "agy-" + term.replace("/", "_"))
    try:
        with open(path) as f:
            if f.read().strip() == cid:
                return False
    except OSError:
        pass
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(cid)
    return True


def background(work):
    """Runs work() in a child that nothing waits for (agy waits for its title command, and for the
    end of its output), so the title shows at once."""
    sys.stdout.flush()
    if os.fork():
        return
    try:
        os.setsid()
        null = os.open(os.devnull, os.O_RDWR)
        for fd in (0, 1, 2):
            os.dup2(null, fd)
        work()
    except Exception:
        pass
    os._exit(0)


def agy_own(pid=None):
    """Whether this agy is its terminal's own interactive agent: not one in print mode (-p, a
    one-off, such as one a Claude runs through its shell), and none with Claude or Codex above it
    (their $HC_TERMINAL_ID isn't the agy's terminal). Read up the process tree from pid (default:
    this process's parent)."""
    pid, seen = pid or os.getppid(), False
    for _ in range(12):
        if pid <= 1:
            return True
        out = subprocess.run(["ps", "-o", "ppid=,args=", "-p", str(pid)], capture_output=True, text=True, timeout=3).stdout.strip()
        ppid, _, args = out.partition(" ")
        words = args.split()
        if not words:
            return True
        prog = os.path.basename(words[0])
        if prog == "agy" and not seen:
            seen = True
            if any(w in ("-p", "--print", "--prompt") or w.startswith(("--print=", "--prompt=")) for w in words[1:]):
                return False
        elif prog in ("claude", "codex") or "@anthropic-ai/claude-code" in args or " app-server" in " " + args:
            return False
        try:
            pid = int(ppid)
        except ValueError:
            return True
    return True


def agy_transcript(cid, given=None):
    """An agy conversation's transcript, the full one when there is one. Hooks give its path. The
    title command's state names one under ~/.gemini/antigravity (agy 1.5.18; that is the desktop
    app's folder), where the CLI keeps none, so the CLI's own is looked for by the conversation."""
    found = []
    if given:
        found += [os.path.join(os.path.dirname(given), "transcript_full.jsonl"), given]
    safe = re.sub(r"[^A-Za-z0-9-]", "", cid or "")
    if safe:
        logs = os.path.join(AGY_HOME, "brain", safe, ".system_generated", "logs")
        found += [os.path.join(logs, "transcript_full.jsonl"), os.path.join(logs, "transcript.jsonl")]
    return next((p for p in found if os.path.isfile(p)), None)


def agy_last(path):
    """The start of the last prompt in an agy conversation, and the reply that came after it (None
    while there's none), from its transcript (JSON lines): a USER_INPUT step holds the prompt in
    <USER_REQUEST>, a PLANNER_RESPONSE step the model's text (or only tool calls)."""
    reply = None
    for entry in tail_entries(path):
        text = entry.get("content") if isinstance(entry.get("content"), str) else ""
        if entry.get("type") == "PLANNER_RESPONSE" and text.strip() and reply is None:
            reply = text
        elif entry.get("type") == "USER_INPUT":
            asked = re.search(r"<USER_REQUEST>\s*(.*?)\s*</USER_REQUEST>", text, re.S)
            prompt = " ".join((asked.group(1) if asked else text).split())[:160]
            if prompt:
                return prompt, reply
    return None, None


def agy_made_title(cid):
    """The title agy made for a conversation itself, a few seconds after its first reply, from its
    conversation_summaries.db (a /rename's name is there too); "" while it has none, or when that
    can't be read."""
    import sqlite3
    from urllib.parse import quote
    db = os.path.join(AGY_HOME, "conversation_summaries.db")
    if not os.path.isfile(db):
        return ""
    try:
        con = sqlite3.connect(f"file:{quote(db)}?mode=ro", uri=True, timeout=0.3)
        try:
            row = con.execute("SELECT title FROM conversation_summaries WHERE conversation_id = ?", (cid,)).fetchone()
        finally:
            con.close()
    except sqlite3.Error:
        return ""
    return str(row[0] or "") if row else ""


DORMANT = "send a prompt to start"  # a job that isn't running, in Claude's words


def job_status(r):
    """A background session's record as Herdr shows an agent's state, by the rules of
    mods/my-tabs/jobs.js jobStatus: tempo "active" from a prompt until the turn ends, "blocked"
    while it waits for you; then state says how the turn ended, "working" when it waits on its
    own task (which wakes it again)."""
    if not isinstance(r, dict):
        return None
    tempo, state = r.get("tempo"), r.get("state")
    if tempo == "active":
        return "working"
    if tempo == "blocked":
        return "idle" if r.get("needs") == DORMANT else "blocked"
    if state in ("working", "starting", "resuming"):
        return "working"
    return state if state in ("blocked", "done") else "idle"


def bg_state(job_dir, wait=12.0):
    """note.bg at the end of a turn. Claude records how the turn ended a moment after Stop (up to
    a few seconds), so its record is read until it no longer says the turn is running."""
    path, end, r = os.path.join(job_dir, "state.json"), time.time() + wait, None
    while True:
        try:
            with open(path) as f:
                r = json.load(f)
        except (OSError, ValueError):
            r = None
        if (isinstance(r, dict) and r.get("tempo") not in ("active", None)) or time.time() >= end:
            break
        time.sleep(0.25)
    when = r.get("updatedAt") if isinstance(r, dict) else None
    return f"{job_status(r) or 'idle'} {os.path.basename(job_dir.rstrip('/'))} {when or now()}"


def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"


def attached(session):
    """The local hc terminals showing a background session: each one running `claude attach
    <session, its name, or the start of its id>`, else a `claude` window titled with the job's
    name (as `claude --resume` shows a background job, with the job's id nowhere in its command)."""
    if not session or os.environ.get("HC_VIA") or os.environ.get("SLURM_SUBMIT_HOST"):
        return []
    hc = shutil.which("hc") or os.path.expanduser("~/.local/bin/hc")
    name, found, titled = job_name(session), [], []
    out = subprocess.run([hc, "ls", "--json"], capture_output=True, text=True, timeout=4).stdout
    for t in json.loads(out or "{}").get("terminals", []):
        address = t.get("address") or ""
        if "/" in address or t.get("state") != "live":
            continue  # another machine's, or ended
        got = json.loads(subprocess.run([hc, "get", address, "--json"], capture_output=True, text=True, timeout=4).stdout or "{}")
        argv = (got.get("foreground") or {}).get("argv") or []
        if not argv or os.path.basename(argv[0]) != "claude":
            continue
        if len(argv) >= 3 and argv[-2] == "attach" and ((len(argv[-1]) >= 6 and session.startswith(argv[-1])) or (name and argv[-1] == name)):
            found.append(address)
        elif name and re.sub(r"^\W+", "", got.get("title") or "").strip() == name:
            titled.append(address)
    return found or titled[:1]


def job_name(session):
    """A background job's name, from Claude's record of it (~/.claude/jobs/<its short id>/)."""
    try:
        with open(os.path.expanduser(f"~/.claude/jobs/{session[:8]}/state.json")) as f:
            state = json.load(f)
    except (OSError, ValueError):
        return None
    return (state.get("name") or "").strip() or None if state.get("sessionId") == session else None


def via():
    """The login node whose hc runs the terminal, when Claude runs on another host (a cluster
    compute node): $HC_VIA, or Slurm's $SLURM_SUBMIT_HOST in an idev session. None on that host."""
    v = (os.environ.get("HC_VIA") or os.environ.get("SLURM_SUBMIT_HOST") or "").split(".")[0]
    return v if v and v != socket.gethostname().split(".")[0] else None


def where(event):
    """note.session, note.cwd and note.host: what Herdr's Fork needs to start a copy of the
    conversation. note.host is empty (the label dropped) unless Claude runs on another host."""
    host = socket.gethostname().split(".")[0] if via() else ""
    return (f"note.session={event.get('session_id') or ''}", f"note.cwd={event.get('cwd') or ''}", f"note.host={host}")


def hc(*args):
    """Runs hc where the terminal's hc is (here, or the login node through ssh); its output."""
    login = via()
    if login:
        remote = "~/.local/bin/hc " + " ".join(shlex.quote(x) for x in args)
        return subprocess.run(["ssh", "-o", "ConnectTimeout=8", login, remote],
                              stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=12).stdout
    path = shutil.which("hc") or os.path.expanduser("~/.local/bin/hc")
    return subprocess.run([path, *args], capture_output=True, text=True, timeout=4).stdout


def label(term, *pairs):
    hc("label", term, *pairs)


def terminal(term):
    """hc's record of the terminal: its status (what Claude last reported), turn and labels."""
    try:
        got = json.loads(hc("get", term, "--json") or "null")
    except (OSError, subprocess.SubprocessError, ValueError):
        return None
    return got if isinstance(got, dict) else None


TURN_ENDS = ("turn_duration", "stop_hook_summary", "away_summary", "compact_boundary")


def between_turns(path, after=False):
    """Whether a compaction started with no turn running: the transcript's last turn had ended
    (or was interrupted), and no prompt or tool call came after it. Local commands (/model,
    /compact itself) don't start turns. after: read from before the boundary this compaction
    just wrote."""
    local = False
    for entry in tail_entries(path):
        kind = entry.get("type")
        if after:
            after = not (kind == "system" and entry.get("subtype") == "compact_boundary")
            continue
        if kind == "system":
            if entry.get("subtype") in TURN_ENDS:
                return True
            continue
        if kind == "assistant":
            return False
        if kind != "user" or entry.get("isMeta") or entry.get("isCompactSummary") or entry.get("isVisibleInTranscriptOnly"):
            continue
        content = (entry.get("message") or {}).get("content")
        if isinstance(content, list) and any(isinstance(b, dict) and b.get("type") == "tool_result" for b in content):
            return False
        text = (content if isinstance(content, str) else " ".join(
            b.get("text", "") for b in content or [] if isinstance(b, dict) and b.get("type") == "text")).strip()
        if text.startswith(("<local-command-stdout>", "<local-command-stderr>")):
            local = True
        elif text.startswith(("<command-name>", "<command-message>")) and local:
            local = False  # a local command's own line
        else:
            return text.startswith("[Request interrupted by user")
    return False


def claude_tty():
    """Claude's terminal, open for writing: the hook's own, else that of the first process up
    the tree that has one. None when there's none."""
    try:
        return os.open("/dev/tty", os.O_WRONLY | os.O_NOCTTY)
    except OSError:
        pass
    pid = os.getppid()
    for _ in range(4):
        out = subprocess.run(["ps", "-o", "ppid=,tty=", "-p", str(pid)], capture_output=True, text=True, timeout=3).stdout.split()
        if len(out) < 2:
            return None
        if out[1] not in ("?", "??", "-"):
            try:
                return os.open(out[1] if out[1].startswith("/") else "/dev/" + out[1], os.O_WRONLY | os.O_NOCTTY)
            except OSError:
                return None
        pid = int(out[0])
    return None


def status(fields):
    """An OSC 7501 record, as Claude writes them to its terminal."""
    tty = claude_tty()
    if tty is None:
        return False
    try:
        os.write(tty, b"\x1b]7501;" + fields.encode() + b"\x07")
    finally:
        os.close(tty)
    return True


def hushed(term):
    """Where hush notes that it cleared the terminal's status (and the title it had)."""
    return os.path.join(tempfile.gettempdir(), f"agent-note-{os.getuid()}", "hushed-" + term.replace("/", "_"))


def hush(term, wait, began):
    """A compaction between turns: once Claude says working (up to wait seconds), clear the
    terminal's status, so its done comes after no working and Herdr takes it as seen. Only when
    the last finish was seen, and when the compaction (begun at time began) is what Claude says
    working for; herdr.seen moves to the turn count the clearing makes."""
    end = time.time() + wait
    while True:
        t = terminal(term)
        state = ((t or {}).get("status") or {}).get("state")
        if state == "working" or time.time() >= end:
            break
        time.sleep(1.0 if via() else 0.4)
    if state != "working":
        return
    since = t.get("status_ms")  # when hc got the working: it stamps changes of state only
    if isinstance(since, (int, float)) and since / 1000 < began - 10:
        return  # working since before the compaction: nothing of its own to hush
    try:
        turn, seen = int(t.get("turn") or 0), int((t.get("labels") or {}).get("herdr.seen"))
    except (TypeError, ValueError):
        return
    if seen < turn:
        return  # a finish you haven't looked at: it keeps its mark
    os.makedirs(os.path.dirname(hushed(term)), exist_ok=True)
    with open(hushed(term), "w") as f:
        json.dump({"title": (t.get("status") or {}).get("title") or ""}, f)
    if status("state=clear"):
        label(term, f"herdr.seen={turn + 1}")  # leaving working counts a turn
    else:
        os.remove(hushed(term))


def unhush(term):
    """A prompt after a hushed compaction: if the status is still cleared (the prompt was sent
    during the compaction, and Claude, working all along, says nothing new), say working."""
    try:
        with open(hushed(term)) as f:
            was = json.load(f)
        os.remove(hushed(term))
    except (OSError, ValueError):
        return
    t = terminal(term)
    if t is not None and not t.get("status"):
        title = base64.b64encode(str(was.get("title") or "").encode()).decode()
        status("state=working:app=claude-code" + (f":title={title}" if title else ""))


CJK = re.compile(r"[\u2e80-\u9fff\uff00-\uffef]")


def width(s):
    return sum(2 if CJK.match(c) else 1 for c in s)


def head(s, n):
    """The start of s that fits n columns, not cutting an English word in two."""
    out, w = "", 0
    for c in s:
        w += width(c)
        if w > n:
            word = lambda x: x.isascii() and x.isalnum()
            if out and word(out[-1]) and word(c) and " " in out:
                out = out[: out.rindex(" ")]
            break
        out += c
    return out.rstrip()


def tail(s, n):
    return head(s[::-1], n)[::-1].lstrip()


def gist(reply):
    """The reply's first sentence …… its last sentence, as plain text: no markdown marks,
    code blocks or tables. At most ~100 columns, about three card lines (CJK counts double)."""
    lines, fenced = [], False
    for raw in (reply or "").splitlines():
        if raw.strip().startswith("```"):
            fenced = not fenced
            continue
        if fenced or raw.lstrip().startswith("|"):
            continue
        line = re.sub(r"^\s*(?:#+|[-*>]|\d+\.)\s+", "", raw).replace("**", "").replace("`", "")
        line = " ".join(line.split())
        if line:
            lines.append(line)
    sentences = [x.strip() for l in lines for x in re.split(r"(?<=[。！？])|(?<=[.!?])\s+", l) if x.strip()]
    if not sentences:
        return ""
    first, last = sentences[0], sentences[-1]
    whole = first if len(sentences) == 1 else first + " " + last if len(sentences) == 2 else None
    if whole and width(whole) <= 100:
        return whole
    return head(first, 40) + " …… " + tail(last, 60)


def compaction_began(path, now):
    """When the compaction a SessionStart(compact) follows began: the time on the boundary it
    wrote (Claude writes it at the end) less how long it took. None when the transcript has no
    boundary from the last two minutes: then this isn't about one in it."""
    for entry in tail_entries(path):
        if entry.get("type") == "system" and entry.get("subtype") == "compact_boundary":
            try:
                ended = datetime.fromisoformat(entry["timestamp"].replace("Z", "+00:00")).timestamp()
                took = float((entry.get("compactMetadata") or {}).get("durationMs") or 0) / 1000
            except (KeyError, AttributeError, TypeError, ValueError):
                return None
            return ended - took if now - ended < 120 else None
    return None


def tail_entries(path):
    """A transcript's last megabyte (JSON lines), newest first; nothing when it isn't there (yet:
    a fork's, at its start)."""
    try:
        with open(path or "", "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - 1_000_000))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return
    for line in reversed(lines):
        try:
            yield json.loads(line)
        except ValueError:
            continue


def last_prompt(path):
    """The start of the last prompt in a transcript: Claude Code records each in a "last-prompt"
    entry; else the last typed user message (not a tool result, summary or command)."""
    for entry in tail_entries(path):
        if entry.get("type") == "last-prompt" and (entry.get("lastPrompt") or "").strip():
            return " ".join(entry["lastPrompt"].split())[:160]
        if entry.get("type") == "user" and not (entry.get("isMeta") or entry.get("isCompactSummary") or entry.get("isVisibleInTranscriptOnly")):
            content = (entry.get("message") or {}).get("content")
            text = content if isinstance(content, str) else " ".join(
                b.get("text", "") for b in content or [] if isinstance(b, dict) and b.get("type") == "text")
            text = " ".join(text.split())
            if text and not re.match(r"<(command-|local-command|system-reminder)", text):
                return text[:160]
    return None


def last_reply(path):
    """The text of the last assistant entry in a transcript (JSON lines), read from its tail."""
    for entry in tail_entries(path):
        if entry.get("type") != "assistant":
            continue
        content = (entry.get("message") or {}).get("content") or []
        texts = [b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text"]
        text = "\n".join(t for t in texts if t.strip())
        if text:
            return text
    return None


