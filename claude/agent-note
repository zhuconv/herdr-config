#!/usr/bin/env python3
"""Claude Code hook for Herdr's ⌃Tab agent switcher (~/.config/herdr-app/mods/agent-switcher).

UserPromptSubmit: the start of the prompt goes in the hc label note.prompt.
Stop: the end of the reply (its last two lines) goes in note.said.
Each also sets note.state: "working" from a prompt until the reply ends, then "idle". Herdr's
Agents list, tab bar and Projects panel read it for sessions that report no status to Herdr
(background ones, `claude attach`) when the tab bar's own label from Claude's record of the
session (note.job, mods/my-tabs/jobs.js) isn't there. An interrupted reply has no Stop: it stays
"working" until the next prompt or reply.
SessionStart: a resumed conversation's card shows its last prompt and reply right away, read
from its transcript, not only after the next prompt. A new one (or /clear) drops the notes the
terminal kept from the conversation before.
All land on the hc terminal the agent runs in ($HC_TERMINAL_ID). A background session runs
under Claude's daemon ($CLAUDE_JOB_DIR), outside any terminal; the $HC_TERMINAL_ID it has is the
daemon's, from whichever terminal started the daemon. Its labels go on every terminal showing
it, found through hc: each running `claude attach <its id>`, else a `claude` window (`claude
--resume` on a background job) titled with the job's name. Outside hc it does nothing. It
prints nothing (a UserPromptSubmit or SessionStart hook's output would join the conversation)
and always exits 0, so it never gets in Claude's way.

note.bg: a background session on a machine without Herdr's app (a server) also says its state
there, for the tab bar on the Mac, which watches only the Mac's own records of Claude's
background sessions (mods/my-tabs/jobs.js). "<state> <job> <time>": working from a prompt; at
the end of a turn, how Claude recorded it ended (done, blocked, or still working when it waits
on its own task), read from ~/.claude/jobs/<job>/state.json once Claude has written it.

On a cluster compute node the terminal's hc runs on the login node. There the label goes
through `ssh <login node>`: $HC_VIA, or Slurm's $SLURM_SUBMIT_HOST in an idev session.
(Vista: plain ssh from a node to login1 needs no MFA; BatchMode=yes would break it.)
"""
import json
import os
import re
import shlex
import shutil
import socket
import subprocess
import sys
import time
from datetime import datetime, timezone


def main():
    event = json.load(sys.stdin)
    job, own = os.environ.get("CLAUDE_JOB_DIR"), os.environ.get("HC_TERMINAL_ID")
    terms = [own] if own and not job else attached(event.get("session_id"))
    if not terms:
        return
    name = event.get("hook_event_name")
    report = bool(job) and not os.path.isdir(os.path.expanduser("~/.config/herdr-app"))
    if name == "UserPromptSubmit":
        key, text, state = "note.prompt", " ".join((event.get("prompt") or "").split())[:160], "working"
    elif name == "Stop":
        reply = event.get("last_assistant_message") or last_reply(event.get("transcript_path"))
        key, text, state = "note.said", gist(reply), "idle"
    elif name == "SessionStart":
        source, path = event.get("source"), event.get("transcript_path")
        if source == "resume":
            prompt, reply = last_prompt(path), gist(last_reply(path))
            pairs = ("note.state=idle", f"note.prompt={prompt}" if prompt else "note.prompt=", f"note.said={reply}" if reply else "note.said=")
        elif source in ("startup", "clear"):
            pairs = ("note.state=idle", "note.prompt=", "note.said=")
        else:
            return
    else:
        return
    if name != "SessionStart":
        pairs = (f"note.state={state}", *([f"{key}={text}"] if text else []))
        if report and name == "UserPromptSubmit":
            pairs += (f"note.bg=working {os.path.basename(job.rstrip('/'))} {now()}",)
    for term in terms:
        label(term, *pairs)
    if report and name == "Stop":
        value = bg_state(job)
        for term in terms:
            label(term, f"note.bg={value}")


DORMANT = "send a prompt to start"  # a job that isn't running, in Claude's words


def job_status(r):
    """A background session's record as Herdr shows an agent's state, by the rules of
    mods/my-tabs/jobs.js jobStatus: tempo "active" from a prompt until the turn ends, "blocked"
    while it waits for you; then state says how the turn ended, "working" when it waits on its
    own task (which wakes it again)."""
    if not isinstance(r, dict):
        return None
    tempo, state = r.get("tempo"), r.get("state")
    if tempo == "active":
        return "working"
    if tempo == "blocked":
        return "idle" if r.get("needs") == DORMANT else "blocked"
    if state in ("working", "starting", "resuming"):
        return "working"
    return state if state in ("blocked", "done") else "idle"


def bg_state(job_dir, wait=12.0):
    """note.bg at the end of a turn. Claude records how the turn ended a moment after Stop (up to
    a few seconds), so its record is read until it no longer says the turn is running."""
    path, end, r = os.path.join(job_dir, "state.json"), time.time() + wait, None
    while True:
        try:
            with open(path) as f:
                r = json.load(f)
        except (OSError, ValueError):
            r = None
        if (isinstance(r, dict) and r.get("tempo") not in ("active", None)) or time.time() >= end:
            break
        time.sleep(0.25)
    when = r.get("updatedAt") if isinstance(r, dict) else None
    return f"{job_status(r) or 'idle'} {os.path.basename(job_dir.rstrip('/'))} {when or now()}"


def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"


def attached(session):
    """The local hc terminals showing a background session: each one running `claude attach
    <session, its name, or the start of its id>`, else a `claude` window titled with the job's
    name (as `claude --resume` shows a background job, with the job's id nowhere in its command)."""
    if not session or os.environ.get("HC_VIA") or os.environ.get("SLURM_SUBMIT_HOST"):
        return []
    hc = shutil.which("hc") or os.path.expanduser("~/.local/bin/hc")
    name, found, titled = job_name(session), [], []
    out = subprocess.run([hc, "ls", "--json"], capture_output=True, text=True, timeout=4).stdout
    for t in json.loads(out or "{}").get("terminals", []):
        address = t.get("address") or ""
        if "/" in address or t.get("state") != "live":
            continue  # another machine's, or ended
        got = json.loads(subprocess.run([hc, "get", address, "--json"], capture_output=True, text=True, timeout=4).stdout or "{}")
        argv = (got.get("foreground") or {}).get("argv") or []
        if not argv or os.path.basename(argv[0]) != "claude":
            continue
        if len(argv) >= 3 and argv[-2] == "attach" and ((len(argv[-1]) >= 6 and session.startswith(argv[-1])) or (name and argv[-1] == name)):
            found.append(address)
        elif name and re.sub(r"^\W+", "", got.get("title") or "").strip() == name:
            titled.append(address)
    return found or titled[:1]


def job_name(session):
    """A background job's name, from Claude's record of it (~/.claude/jobs/<its short id>/)."""
    try:
        with open(os.path.expanduser(f"~/.claude/jobs/{session[:8]}/state.json")) as f:
            state = json.load(f)
    except (OSError, ValueError):
        return None
    return (state.get("name") or "").strip() or None if state.get("sessionId") == session else None


def label(term, *pairs):
    via = (os.environ.get("HC_VIA") or os.environ.get("SLURM_SUBMIT_HOST") or "").split(".")[0]
    if via and via != socket.gethostname().split(".")[0]:
        remote = "~/.local/bin/hc label " + " ".join(shlex.quote(x) for x in (term, *pairs))
        subprocess.run(["ssh", "-o", "ConnectTimeout=8", via, remote],
                       stdin=subprocess.DEVNULL, capture_output=True, timeout=12)
    else:
        hc = shutil.which("hc") or os.path.expanduser("~/.local/bin/hc")
        subprocess.run([hc, "label", term, *pairs], capture_output=True, timeout=4)


CJK = re.compile(r"[\u2e80-\u9fff\uff00-\uffef]")


def width(s):
    return sum(2 if CJK.match(c) else 1 for c in s)


def head(s, n):
    """The start of s that fits n columns, not cutting an English word in two."""
    out, w = "", 0
    for c in s:
        w += width(c)
        if w > n:
            word = lambda x: x.isascii() and x.isalnum()
            if out and word(out[-1]) and word(c) and " " in out:
                out = out[: out.rindex(" ")]
            break
        out += c
    return out.rstrip()


def tail(s, n):
    return head(s[::-1], n)[::-1].lstrip()


def gist(reply):
    """The reply's first sentence …… its last sentence, as plain text: no markdown marks,
    code blocks or tables. At most ~100 columns, about three card lines (CJK counts double)."""
    lines, fenced = [], False
    for raw in (reply or "").splitlines():
        if raw.strip().startswith("```"):
            fenced = not fenced
            continue
        if fenced or raw.lstrip().startswith("|"):
            continue
        line = re.sub(r"^\s*(?:#+|[-*>]|\d+\.)\s+", "", raw).replace("**", "").replace("`", "")
        line = " ".join(line.split())
        if line:
            lines.append(line)
    sentences = [x.strip() for l in lines for x in re.split(r"(?<=[。！？])|(?<=[.!?])\s+", l) if x.strip()]
    if not sentences:
        return ""
    first, last = sentences[0], sentences[-1]
    whole = first if len(sentences) == 1 else first + " " + last if len(sentences) == 2 else None
    if whole and width(whole) <= 100:
        return whole
    return head(first, 40) + " …… " + tail(last, 60)


def tail_entries(path):
    """A transcript's last megabyte (JSON lines), newest first."""
    if not path:
        return []
    with open(path, "rb") as f:
        f.seek(0, os.SEEK_END)
        f.seek(max(0, f.tell() - 1_000_000))
        lines = f.read().decode("utf-8", "replace").splitlines()
    for line in reversed(lines):
        try:
            yield json.loads(line)
        except ValueError:
            continue


def last_prompt(path):
    """The start of the last prompt in a transcript: Claude Code records each in a "last-prompt"
    entry; else the last typed user message (not a tool result, summary or command)."""
    for entry in tail_entries(path):
        if entry.get("type") == "last-prompt" and (entry.get("lastPrompt") or "").strip():
            return " ".join(entry["lastPrompt"].split())[:160]
        if entry.get("type") == "user" and not (entry.get("isMeta") or entry.get("isCompactSummary") or entry.get("isVisibleInTranscriptOnly")):
            content = (entry.get("message") or {}).get("content")
            text = content if isinstance(content, str) else " ".join(
                b.get("text", "") for b in content or [] if isinstance(b, dict) and b.get("type") == "text")
            text = " ".join(text.split())
            if text and not re.match(r"<(command-|local-command|system-reminder)", text):
                return text[:160]
    return None


def last_reply(path):
    """The text of the last assistant entry in a transcript (JSON lines), read from its tail."""
    for entry in tail_entries(path):
        if entry.get("type") != "assistant":
            continue
        content = (entry.get("message") or {}).get("content") or []
        texts = [b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text"]
        text = "\n".join(t for t in texts if t.strip())
        if text:
            return text
    return None


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
